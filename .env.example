# Compose PostgreSQL defaults. Change the password before using this outside development.
POSTGRES_DB=portable_notes
POSTGRES_USER=portable_notes
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://portable_notes:change-this-password@db:5432/portable_notes

# App settings
APP_PORT=5000
APP_VERSION=0.1.0

# Keep DATABASE_URL credentials aligned with POSTGRES_* when using the Compose database.
# To use an existing PostgreSQL server, replace DATABASE_URL with its connection string
# and start only the app service: docker compose up -d app
